<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>

        <link rel="stylesheet" href="{{ asset('css/style.css') }}">
        {% block stylesheets %}
        {% endblock %}
    </head>
    <body>
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <p>{{ message }}</p>
            {% endfor %}
        {% endfor %}
        {% include 'shared/navigation.html.twig' %}
        {% block body %}{% endblock %}
    </body>
</html>
